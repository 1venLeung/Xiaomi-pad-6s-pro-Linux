diff --git a/drivers/gpu/drm/msm/adreno/adreno_device.c b/drivers/gpu/drm/msm/adreno/adreno_device.c
index fc38331ce..465fdad2e 100644
--- a/drivers/gpu/drm/msm/adreno/adreno_device.c
+++ b/drivers/gpu/drm/msm/adreno/adreno_device.c
@@ -8,6 +8,9 @@
 
 #include "adreno_gpu.h"
 
+#include <linux/kernel.h>
+#include <linux/of.h>
+
 bool hang_debug = false;
 MODULE_PARM_DESC(hang_debug, "Dump registers when hang is detected (can be slow!)");
 module_param_named(hang_debug, hang_debug, bool, 0600);
@@ -358,6 +361,31 @@ static void resume_scheduler(struct msm_gpu *gpu)
 	}
 }
 
+static bool adreno_block_system_suspend(struct msm_gpu *gpu)
+{
+	struct adreno_gpu *adreno_gpu = to_adreno_gpu(gpu);
+
+	/*
+	 * Xiaomi Pad 6S Pro (sheng) currently cannot reliably system-suspend
+	 * its Adreno 740/GMU stack.  The observed failure mode is a half-failed
+	 * suspend where the GMU stops responding to OOB GPU_SET requests, KWin
+	 * loses its GL context, and the display is left with only the hardware
+	 * cursor visible.
+	 *
+	 * Keep runtime PM untouched, but reject real system suspend on this
+	 * platform until the A740 GMU suspend/resume sequence is fixed.
+	 */
+	if (system_state == SYSTEM_SUSPEND &&
+	    of_machine_is_compatible("xiaomi,sheng") &&
+	    adreno_is_a740(adreno_gpu)) {
+		dev_warn_once(gpu->dev->dev,
+			      "blocking system suspend: xiaomi,sheng A740 GMU suspend is unstable\n");
+		return true;
+	}
+
+	return false;
+}
+
 static int adreno_system_suspend(struct device *dev)
 {
 	struct msm_gpu *gpu = dev_to_gpu(dev);
@@ -366,6 +394,9 @@ static int adreno_system_suspend(struct device *dev)
 	if (!gpu)
 		return 0;
 
+	if (adreno_block_system_suspend(gpu))
+		return -EBUSY;
+
 	suspend_scheduler(gpu);
 
 	remaining = wait_event_timeout(gpu->retire_event,
diff --git a/kernel/power/suspend.c b/kernel/power/suspend.c
index 57c442686..73b345087 100644
--- a/kernel/power/suspend.c
+++ b/kernel/power/suspend.c
@@ -31,6 +31,7 @@
 #include <linux/compiler.h>
 #include <linux/moduleparam.h>
 #include <linux/fs.h>
+#include <linux/of.h>
 
 #include "power.h"
 
@@ -74,6 +75,28 @@ bool pm_suspend_default_s2idle(void)
 }
 EXPORT_SYMBOL_GPL(pm_suspend_default_s2idle);
 
+static bool pm_suspend_blocked_by_platform_quirk(suspend_state_t state)
+{
+	/*
+	 * Xiaomi Pad 6S Pro (sheng) currently cannot reliably enter system
+	 * suspend with the mainline Adreno 740/GMU stack.  The failure observed
+	 * on this platform leaves the compositor with a lost GL context and the
+	 * display showing only the hardware cursor after resume.
+	 *
+	 * Reject the system suspend request at the PM core entry point.  This is
+	 * intentionally earlier than device callbacks because the GPU may already
+	 * be runtime-suspended or may not receive the callback path consistently.
+	 * Runtime PM and normal shutdown/reboot paths are left untouched.
+	 */
+	if (of_machine_is_compatible("xiaomi,sheng")) {
+		pr_warn_once("blocking system suspend state %s: xiaomi,sheng A740 GMU suspend is unstable\n",
+			     mem_sleep_labels[state]);
+		return true;
+	}
+
+	return false;
+}
+
 void s2idle_set_ops(const struct platform_s2idle_ops *ops)
 {
 	unsigned int sleep_flags;
@@ -640,6 +663,9 @@ int pm_suspend(suspend_state_t state)
 	if (state <= PM_SUSPEND_ON || state >= PM_SUSPEND_MAX)
 		return -EINVAL;
 
+	if (pm_suspend_blocked_by_platform_quirk(state))
+		return -EBUSY;
+
 	pr_info("suspend entry (%s)\n", mem_sleep_labels[state]);
 	error = enter_state(state);
 	dpm_save_errno(error);
