@@ -32,6 +32,7 @@
 #define WN8030_CHARGE_SYNC_RETRIES 10
 #define WN8030_CHARGE_REFRESH_RETRIES 8
 #define WN8030_CHARGE_QUIESCE_MS 600
+#define WN8030_USB_WEAK_PRESENT_UV 100000
 #define WN8030_USB_PRESENT_UV 1000000
 #define WN8030_USB_DETACH_PROBE_IGNORE_MS 2500
 
@@ -976,7 +977,7 @@ static void nanosic_wn8030_battmgr_sync_worker(struct work_struct *data)
 }
 
 static bool nanosic_wn8030_read_usb_supply_state(const char *name, bool *charge_on,
-						 bool *online)
+						 bool *online, bool *candidate_present)
 {
 	union power_supply_propval val;
 	struct power_supply *psy;
@@ -990,10 +991,14 @@ static bool nanosic_wn8030_read_usb_supply_state(const char *name, bool *charge_
 	if (!power_supply_get_property(psy, POWER_SUPPLY_PROP_ONLINE, &val) && val.intval > 0) {
 		*online = true;
 		*charge_on = true;
+		*candidate_present = true;
+	}
+	if (!power_supply_get_property(psy, POWER_SUPPLY_PROP_VOLTAGE_NOW, &val)) {
+		if (val.intval >= WN8030_USB_WEAK_PRESENT_UV)
+			*candidate_present = true;
+		if (val.intval >= WN8030_USB_PRESENT_UV)
+			*charge_on = true;
 	}
