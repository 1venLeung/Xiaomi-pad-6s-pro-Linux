+	found |= nanosic_wn8030_read_usb_supply_state("qcom-battmgr-usb", &charge_on,
+						      &online, &candidate_present);
 	found |= nanosic_wn8030_read_usb_supply_state("ucsi-source-psy-pmic_glink.ucsi.01",
-						      &charge_on, &online);
+						      &charge_on, &online, &candidate_present);
 	if (!found) {
 		if (++nanosic->charge_sync_retries <= WN8030_CHARGE_SYNC_RETRIES) {
 			mod_delayed_work(system_wq, &nanosic->charge_worker, msecs_to_jiffies(500));
@@ -1064,7 +1071,13 @@ static void nanosic_wn8030_charge_worker(struct work_struct *data)
 	nanosic->usb_power_present = charge_on;
 	attached = nanosic->keyboard_attached;
 	probe_active = nanosic->charge_probe_active;
-	if (probe_active && !online && !nanosic->charge_quiesce_done) {
+	if (probe_active && !online && !candidate_present) {
+		nanosic->charge_probe_active = false;
+		nanosic->charge_quiesce_done = false;
+		nanosic->charge_refresh_retries = 0;
+		probe_active = false;
+	}
+	if (probe_active && !online && candidate_present && !nanosic->charge_quiesce_done) {
 		nanosic->charge_quiesce_done = true;
 		do_quiesce = true;
 	}
@@ -1099,10 +1112,12 @@ static void nanosic_wn8030_charge_worker(struct work_struct *data)
 
 		charge_on = false;
 		online = false;
+		candidate_present = false;
 		found = false;
-		found |= nanosic_wn8030_read_usb_supply_state("qcom-battmgr-usb", &charge_on, &online);
+		found |= nanosic_wn8030_read_usb_supply_state("qcom-battmgr-usb", &charge_on,
+							      &online, &candidate_present);
 		found |= nanosic_wn8030_read_usb_supply_state("ucsi-source-psy-pmic_glink.ucsi.01",
-							      &charge_on, &online);
+							      &charge_on, &online, &candidate_present);
 		if (!found)
 			return;
 
@@ -1141,7 +1156,7 @@ static void nanosic_wn8030_charge_worker(struct work_struct *data)
 	 * require another PMIC/UCSI refresh.  Keep refreshing only while the
