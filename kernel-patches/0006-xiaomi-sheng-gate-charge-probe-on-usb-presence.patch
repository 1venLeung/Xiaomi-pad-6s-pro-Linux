-	    val.intval >= WN8030_USB_PRESENT_UV)
-		*charge_on = true;
 
 	power_supply_put(psy);
 
@@ -1033,6 +1038,7 @@ static void nanosic_wn8030_charge_worker(struct work_struct *data)
 	bool found = false;
 	bool charge_on = false;
 	bool online = false;
+	bool candidate_present = false;
 	bool target_charge_power = true;
 	bool unchanged;
 	bool probe_active;
@@ -1045,9 +1051,10 @@ static void nanosic_wn8030_charge_worker(struct work_struct *data)
 	if (!attached)
 		return;
 
