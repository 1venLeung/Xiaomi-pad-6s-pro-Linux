+static void nanosic_wn8030_start_charge_probe(struct nanosic_wn8030 *nanosic,
+					      const char *source)
+{
+	bool start = false;
+	bool ignore_detach;
+
+	mutex_lock(&nanosic->conn_mutex);
+	ignore_detach = nanosic->last_usb_detach_jiffies &&
+		time_before(jiffies, nanosic->last_usb_detach_jiffies +
+			    msecs_to_jiffies(WN8030_USB_DETACH_PROBE_IGNORE_MS));
+	if (nanosic->keyboard_attached && !nanosic->charge_probe_active &&
+	    !ignore_detach) {
+		nanosic->charge_probe_active = true;
+		nanosic->charge_quiesce_done = false;
+		nanosic->charge_refresh_retries = 0;
+		start = true;
+		dev_info(nanosic->dev, "starting charger probe from %s\n", source);
+	}
+	mutex_unlock(&nanosic->conn_mutex);
+
+	if (start)
+		mod_delayed_work(system_wq, &nanosic->charge_worker,
+				 msecs_to_jiffies(100));
+}
