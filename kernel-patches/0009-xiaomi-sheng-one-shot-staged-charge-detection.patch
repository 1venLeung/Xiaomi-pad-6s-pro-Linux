+static void nanosic_wn8030_battmgr_sync_worker(struct work_struct *data)
+{
+	struct nanosic_wn8030 *nanosic =
+		container_of(data, struct nanosic_wn8030, battmgr_sync_worker.work);
+	bool attached;
+	int ret;
+
+	mutex_lock(&nanosic->conn_mutex);
+	attached = nanosic->keyboard_attached;
+	mutex_unlock(&nanosic->conn_mutex);
+
+	ret = qcom_battmgr_xiaomi_set_keyboard_attached(attached);
+	if (ret == -EPROBE_DEFER || ret == -EAGAIN || ret == -ETIMEDOUT) {
+		if (++nanosic->battmgr_sync_retries <= WN8030_BATTMGR_SYNC_RETRIES) {
+			mod_delayed_work(system_wq, &nanosic->battmgr_sync_worker,
+					 msecs_to_jiffies(500));
+			return;
+		}
+	}
+
+	if (ret)
+		dev_warn(nanosic->dev,
+			 "failed to report keyboard %s to charger firmware: %d\n",
+			 attached ? "attached" : "detached", ret);
+	else
+		nanosic->battmgr_sync_retries = 0;
+}
