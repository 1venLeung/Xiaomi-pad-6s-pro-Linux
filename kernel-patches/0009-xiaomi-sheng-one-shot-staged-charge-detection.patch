+static bool nanosic_wn8030_read_usb_supply_state(const char *name, bool *online,
+						 bool *candidate_present)
+{
+	union power_supply_propval val;
+	struct power_supply *psy;
+	bool found = false;
+
+	psy = power_supply_get_by_name(name);
+	if (!psy)
+		return false;
+
+	found = true;
+	if (!power_supply_get_property(psy, POWER_SUPPLY_PROP_ONLINE, &val) && val.intval > 0) {
+		*online = true;
+		*candidate_present = true;
+	}
+	if (!power_supply_get_property(psy, POWER_SUPPLY_PROP_VOLTAGE_NOW, &val) &&
+	    val.intval >= WN8030_USB_WEAK_PRESENT_UV)
+		*candidate_present = true;
+
+	power_supply_put(psy);
+
+	return found;
+}
+
+static bool nanosic_wn8030_read_usb_state(bool *online, bool *candidate_present)
+{
+	bool found = false;
+
+	*online = false;
+	*candidate_present = false;
+	found |= nanosic_wn8030_read_usb_supply_state("qcom-battmgr-usb", online,
+						      candidate_present);
+	found |= nanosic_wn8030_read_usb_supply_state("ucsi-source-psy-pmic_glink.ucsi.01",
+						      online, candidate_present);
+
+	return found;
+}
+
+static void nanosic_wn8030_restore_input(struct nanosic_wn8030 *nanosic)
+{
+	int ret;
+
+	ret = nanosic_wn8030_set_kb_power(nanosic, true);
+	if (ret)
+		dev_warn(nanosic->dev, "failed to restore keyboard after charge detection: %d\n",
+			 ret);
+	ret = nanosic_wn8030_set_touchpad(nanosic, true);
+	if (ret)
+		dev_warn(nanosic->dev, "failed to restore touchpad after charge detection: %d\n",
+			 ret);
+}
+
+static bool nanosic_wn8030_refresh_and_wait(unsigned int delay_ms)
+{
+	bool online, candidate_present;
+
+	pmic_glink_ucsi_xiaomi_connector_refresh();
+	msleep(delay_ms);
+	nanosic_wn8030_read_usb_state(&online, &candidate_present);
+
+	return online;
+}
+
+static bool nanosic_wn8030_detect_charge_once(struct nanosic_wn8030 *nanosic)
+{
+	bool online = false;
+	int ret;
+
+	dev_info(nanosic->dev, "starting one-shot charger detection\n");
+
+	/*
+	 * First release only the MCU sleep state. Regulators, firmware and HID
+	 * devices stay intact, so this is the least disruptive detection window.
+	 */
+	disable_irq(nanosic->client->irq);
+	gpiod_set_value_cansleep(nanosic->sleep_gpio, 1);
+	online = nanosic_wn8030_refresh_and_wait(WN8030_CHARGE_SLEEP_MS);
+	gpiod_set_value_cansleep(nanosic->sleep_gpio, 0);
+	msleep(25);
+	nanosic->suspended = false;
+	enable_irq(nanosic->client->irq);
+	nanosic_wn8030_restore_input(nanosic);
+	if (online) {
+		dev_info(nanosic->dev, "charger detected after WN8030 sleep window\n");
+		return true;
+	}
+
+	/*
+	 * If sleep was insufficient, assert reset while keeping both regulators
+	 * enabled. Firmware is reloaded only once before escalating further.
+	 */
+	disable_irq(nanosic->client->irq);
+	gpiod_set_value_cansleep(nanosic->reset_gpio, 1);
+	online = nanosic_wn8030_refresh_and_wait(WN8030_CHARGE_RESET_MS);
+	gpiod_set_value_cansleep(nanosic->reset_gpio, 0);
+	msleep(20);
+	ret = nanosic_wn8030_load_fw(nanosic);
+	nanosic->suspended = false;
+	enable_irq(nanosic->client->irq);
+	if (ret)
+		dev_warn(nanosic->dev, "failed to reload WN8030 after reset window: %d\n", ret);
+	else
+		nanosic_wn8030_restore_input(nanosic);
+	if (online) {
+		dev_info(nanosic->dev, "charger detected after WN8030 reset window\n");
+		return true;
+	}
+
+	/*
+	 * Last resort: the v7-proven complete power release. This can briefly
+	 * interrupt input, but it is allowed at most once for a physical attach.
+	 */
+	disable_irq(nanosic->client->irq);
+	cancel_delayed_work_sync(&nanosic->wake_worker);
+	nanosic_wn8030_power_off(nanosic);
+	online = nanosic_wn8030_refresh_and_wait(WN8030_CHARGE_QUIESCE_MS);
+	ret = nanosic_wn8030_power_on(nanosic);
+	if (!ret)
+		ret = nanosic_wn8030_load_fw(nanosic);
+	nanosic->suspended = false;
+	enable_irq(nanosic->client->irq);
+	if (ret)
+		dev_warn(nanosic->dev, "failed to restore WN8030 after full charge window: %d\n",
+			 ret);
+	else {
+		nanosic_wn8030_restore_input(nanosic);
+		schedule_delayed_work(&nanosic->wake_worker, msecs_to_jiffies(12000));
+	}
+
+	if (!online)
+		online = nanosic_wn8030_refresh_and_wait(500);
+	if (online)
+		dev_info(nanosic->dev, "charger detected after full WN8030 power window\n");
+	else
+		dev_warn(nanosic->dev,
+			 "one-shot charger detection failed; locked until physical USB detach\n");
+
+	return online;
+}
+
+static void nanosic_wn8030_set_charge_path(struct nanosic_wn8030 *nanosic, bool enable)
+{
+	int ret;
+
+	mutex_lock(&nanosic->conn_mutex);
+	if (nanosic->charge_power_valid && nanosic->charge_power_on == enable) {
+		mutex_unlock(&nanosic->conn_mutex);
+		return;
+	}
+	mutex_unlock(&nanosic->conn_mutex);
+
+	ret = nanosic_wn8030_set_charge_power(nanosic, enable);
+	if (ret) {
+		dev_warn(nanosic->dev, "failed to %s keyboard charge power: %d\n",
+			 enable ? "enable" : "disable", ret);
+		return;
+	}
+	mutex_lock(&nanosic->conn_mutex);
+	nanosic->charge_power_valid = true;
+	nanosic->charge_power_on = enable;
+	mutex_unlock(&nanosic->conn_mutex);
+	dev_info(nanosic->dev, "keyboard charge power %s\n", enable ? "enabled" : "disabled");
+}
+
+static void nanosic_wn8030_charge_worker(struct work_struct *data)
+{
+	struct nanosic_wn8030 *nanosic =
+		container_of(data, struct nanosic_wn8030, charge_worker.work);
+	bool attached, attempted;
+	bool online, candidate_present;
+
+	if (!nanosic_wn8030_read_usb_state(&online, &candidate_present))
+		return;
+
+	mutex_lock(&nanosic->conn_mutex);
+	attached = nanosic->keyboard_attached;
+	attempted = nanosic->charge_attempted;
+	if (!online && !candidate_present && attempted) {
+		nanosic->charge_attempted = false;
+		attempted = false;
+		dev_info(nanosic->dev, "USB detached; charger detection rearmed\n");
+	}
+	if (attached && candidate_present && !online && !attempted)
+		nanosic->charge_attempted = true;
+	if (online)
+		nanosic->charge_attempted = true;
+	mutex_unlock(&nanosic->conn_mutex);
+
+	if (!attached)
+		return;
+
+	nanosic_wn8030_set_charge_path(nanosic, true);
+
+	if (candidate_present && !online && !attempted) {
+		nanosic_wn8030_set_charge_path(nanosic, false);
+		nanosic_wn8030_detect_charge_once(nanosic);
+		nanosic_wn8030_set_charge_path(nanosic, true);
+	}
+}
+
+static bool nanosic_wn8030_is_usb_power_supply(struct power_supply *psy)
+{
+	const char *name;
+
+	if (!psy || !psy->desc || !psy->desc->name)
+		return false;
+
+	name = psy->desc->name;
+
+	return !strcmp(name, "qcom-battmgr-usb") ||
+	       !strncmp(name, "ucsi-source-psy-", strlen("ucsi-source-psy-"));
+}
+
+static int nanosic_wn8030_power_supply_event(struct notifier_block *nb,
+					     unsigned long event, void *ptr)
+{
+	struct nanosic_wn8030 *nanosic =
+		container_of(nb, struct nanosic_wn8030, power_supply_nb);
+	struct power_supply *psy = ptr;
+
+	if (event != PSY_EVENT_PROP_CHANGED || !nanosic_wn8030_is_usb_power_supply(psy))
+		return NOTIFY_OK;
+
+	mod_delayed_work(system_wq, &nanosic->charge_worker, 0);
+
+	return NOTIFY_OK;
+}
