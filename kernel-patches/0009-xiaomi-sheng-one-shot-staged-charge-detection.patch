+static int nanosic_wn8030_set_charge_power(struct nanosic_wn8030 *nanosic, bool enable)
+{
+	u8 buf[XM_WN8030_I2C_WRITE] = { 0x32, 0x00, 0x4E, 0x31,
+					0x81, 0x38, 0x42, 0x19 };
+
+	buf[8] = enable;
+	buf[33] = nanosic_wn8030_checksum8(&buf[2], sizeof(buf) - 2);
+
+	return regmap_bulk_write(nanosic->regmap, 0x5c, buf, sizeof(buf));
