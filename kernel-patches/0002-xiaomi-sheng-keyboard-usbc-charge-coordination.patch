+static bool nanosic_wn8030_read_usb_supply_state(const char *name, bool *charge_on,
+						 bool *online)
+{
+	union power_supply_propval val;
+	struct power_supply *psy;
+	bool found = false;
+
+	psy = power_supply_get_by_name(name);
+	if (!psy)
+		return false;
+
+	found = true;
+	if (!power_supply_get_property(psy, POWER_SUPPLY_PROP_ONLINE, &val) && val.intval > 0) {
+		*online = true;
+		*charge_on = true;
+	}
+	if (!power_supply_get_property(psy, POWER_SUPPLY_PROP_VOLTAGE_NOW, &val) && val.intval > 0)
+		*charge_on = true;
+
+	power_supply_put(psy);
+
+	return found;
+}
+
+static void nanosic_wn8030_request_charge_refresh(struct nanosic_wn8030 *nanosic,
+						  bool online)
+{
+	int ret;
+
+	ret = qcom_battmgr_xiaomi_set_keyboard_attached(true);
+	if (ret && ret != -EAGAIN && ret != -EPROBE_DEFER && ret != -ETIMEDOUT)
+		dev_warn(nanosic->dev, "failed to refresh keyboard charger state: %d\n", ret);
+
+	ret = pmic_glink_ucsi_xiaomi_connector_refresh();
+	if (ret && ret != -EAGAIN && ret != -EPROBE_DEFER)
+		dev_warn(nanosic->dev, "failed to refresh UCSI connector: %d\n", ret);
+
+	if (!online && nanosic->charge_refresh_retries++ < WN8030_CHARGE_REFRESH_RETRIES)
+		mod_delayed_work(system_wq, &nanosic->charge_worker, msecs_to_jiffies(500));
+	else if (online)
+		nanosic->charge_refresh_retries = 0;
+}
+
+static void nanosic_wn8030_charge_worker(struct work_struct *data)
+{
+	struct nanosic_wn8030 *nanosic =
+		container_of(data, struct nanosic_wn8030, charge_worker.work);
+	bool attached;
+	bool found = false;
+	bool charge_on = false;
+	bool online = false;
+	bool unchanged;
+	int ret;
+
+	mutex_lock(&nanosic->conn_mutex);
+	attached = nanosic->keyboard_attached;
+	mutex_unlock(&nanosic->conn_mutex);
+	if (!attached)
+		return;
+
+	found |= nanosic_wn8030_read_usb_supply_state("qcom-battmgr-usb", &charge_on, &online);
+	found |= nanosic_wn8030_read_usb_supply_state("ucsi-source-psy-pmic_glink.ucsi.01",
+						      &charge_on, &online);
+	if (!found) {
+		if (++nanosic->charge_sync_retries <= WN8030_CHARGE_SYNC_RETRIES) {
+			mod_delayed_work(system_wq, &nanosic->charge_worker, msecs_to_jiffies(500));
+			return;
+		}
+		dev_warn(nanosic->dev, "USB power supplies not ready for charge coordination\n");
+		return;
+	}
+	nanosic->charge_sync_retries = 0;
+
+	mutex_lock(&nanosic->conn_mutex);
+	attached = nanosic->keyboard_attached;
+	unchanged = nanosic->charge_power_valid && nanosic->charge_power_on == charge_on;
+	mutex_unlock(&nanosic->conn_mutex);
+	if (!attached)
+		return;
+
+	if (!unchanged) {
+		ret = nanosic_wn8030_set_charge_power(nanosic, charge_on);
+		if (ret) {
+			dev_warn(nanosic->dev, "failed to %s keyboard charge power: %d\n",
+				 charge_on ? "enable" : "disable", ret);
+			return;
+		}
+		dev_info(nanosic->dev, "keyboard charge power %s\n",
+			 charge_on ? "enabled" : "disabled");
+	}
+
+	mutex_lock(&nanosic->conn_mutex);
+	nanosic->charge_power_valid = true;
+	nanosic->charge_power_on = charge_on;
+	mutex_unlock(&nanosic->conn_mutex);
+
+	if (charge_on)
+		nanosic_wn8030_request_charge_refresh(nanosic, online);
+	else
+		nanosic->charge_refresh_retries = 0;
+}
+
+static bool nanosic_wn8030_is_usb_power_supply(struct power_supply *psy)
+{
+	const char *name;
+
+	if (!psy || !psy->desc || !psy->desc->name)
+		return false;
+
+	name = psy->desc->name;
+
+	return !strcmp(name, "qcom-battmgr-usb") ||
+	       !strncmp(name, "ucsi-source-psy-", strlen("ucsi-source-psy-"));
+}
+
+static int nanosic_wn8030_power_supply_event(struct notifier_block *nb,
+					     unsigned long event, void *ptr)
+{
+	struct nanosic_wn8030 *nanosic =
+		container_of(nb, struct nanosic_wn8030, power_supply_nb);
+	struct power_supply *psy = ptr;
+
+	if (event != PSY_EVENT_PROP_CHANGED || !nanosic_wn8030_is_usb_power_supply(psy))
+		return NOTIFY_OK;
+
+	mod_delayed_work(system_wq, &nanosic->charge_worker, 0);
+
+	return NOTIFY_OK;
+}
